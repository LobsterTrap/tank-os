# Pinned to Fedora 44, not `latest` -- the OpenShell RPM filenames below are
# hardcoded to the `fc44` build (that's the only Fedora release OpenShell
# currently publishes RPMs for). If OpenShell starts publishing fc45+
# builds and this moves off Fedora 44, update both together.
ARG FEDORA_BOOTC_BASE=quay.io/fedora/fedora-bootc:44
FROM ${FEDORA_BOOTC_BASE}

LABEL containers.bootc=1 \
  org.opencontainers.image.title="tank-os" \
  org.opencontainers.image.description="Fedora bootc image for OpenClaw on rootless Podman" \
  org.opencontainers.image.source="https://github.com/LobsterTrap/tank-os"

ARG OPENCLAW_UID=1000
ARG OPENCLAW_GID=1000
ARG OPENCLAW_SUBID_START=100000
ARG OPENCLAW_SUBID_COUNT=65536

# Pinned, date-stamped CSB tag -- see
# docs/dev/csb-bootc-deployment-design.md Open Question 1. CSB rebuilds
# daily; do not use csb-latest here.
ARG CSB_IMAGE_TAG=quay.io/redhat-et/openclaw:csb-arm64-openclaw-v2026.7.2-beta.7

# Default model for a fresh OpenClaw config. The upstream openclaw-csb demo
# runbook's own pinned value (openai/gpt-5.5) turned out to no longer be a
# model OpenAI serves; re-pinning here should be a build-arg bump, not a
# bootstrap-csb-sandbox edit.
ARG OPENCLAW_DEFAULT_MODEL=openai/gpt-5.6-luna

# OpenShell CLI + gateway RPMs, pinned to a tagged release rather than
# `latest` for reproducible builds.
ARG OPENSHELL_VERSION=0.0.99

# llmman (https://github.com/llmmanorg/llmman) serves local models as an
# Ollama/OpenAI/Anthropic-compatible endpoint, with the models themselves
# stored and distributed as plain OCI artifacts -- the same registries,
# mirrors, signing and retention story bootc already tells for the OS
# image. Pinned to a release and to repo-owned SHA-256 digests, so a build
# can only ever install the exact binary reviewed here. To bump, update all
# three values together (see docs/llmman.md).
ARG LLMMAN_REPO=llmmanorg/llmman
ARG LLMMAN_VERSION=0.1.491
ARG LLMMAN_SHA256_X86_64=5feb2685350f6273199949d10fba852fe6f73b86eafa62fbef988a375b4b9826
ARG LLMMAN_SHA256_AARCH64=e41b32812d7358a06dcdfcfae0907b2d8b3b10a5654e2fce50ecd0d3f15d91b1

RUN set -eux; \
    dnf -y install \
      cloud-init \
      curl \
      openssh-server \
      podman \
      python3 \
      qemu-guest-agent \
      shadow-utils \
      sudo \
      vim-enhanced; \
    arch="$(rpm -E %{_arch})"; \
    openshell_base_url="https://github.com/NVIDIA/OpenShell/releases/download/v${OPENSHELL_VERSION}"; \
    openshell_rpm="openshell-${OPENSHELL_VERSION}-1.fc44.${arch}.rpm"; \
    openshell_gateway_rpm="openshell-gateway-${OPENSHELL_VERSION}-1.fc44.${arch}.rpm"; \
    curl -fsSL -o "/tmp/${openshell_rpm}" "${openshell_base_url}/${openshell_rpm}"; \
    curl -fsSL -o "/tmp/${openshell_gateway_rpm}" "${openshell_base_url}/${openshell_gateway_rpm}"; \
    curl -fsSL -o /tmp/openshell-checksums-sha256.txt "${openshell_base_url}/openshell-checksums-sha256.txt"; \
    (cd /tmp && grep -E " (${openshell_rpm}|${openshell_gateway_rpm})\$" openshell-checksums-sha256.txt | sha256sum -c -); \
    dnf -y install "/tmp/${openshell_rpm}" "/tmp/${openshell_gateway_rpm}"; \
    rm -f "/tmp/${openshell_rpm}" "/tmp/${openshell_gateway_rpm}" /tmp/openshell-checksums-sha256.txt; \
    case "${arch}" in \
      x86_64) llmman_sha256="${LLMMAN_SHA256_X86_64}" ;; \
      aarch64) llmman_sha256="${LLMMAN_SHA256_AARCH64}" ;; \
      *) echo "unsupported arch for llmman: ${arch}" >&2; exit 1 ;; \
    esac; \
    llmman_asset="llmman-${arch}-unknown-linux-gnu"; \
    curl -fsSL -o "/tmp/${llmman_asset}" \
      "https://github.com/${LLMMAN_REPO}/releases/download/v${LLMMAN_VERSION}/${llmman_asset}"; \
    echo "${llmman_sha256}  /tmp/${llmman_asset}" | sha256sum -c -; \
    install -m 0755 "/tmp/${llmman_asset}" /usr/bin/llmman; \
    rm -f "/tmp/${llmman_asset}"; \
    /usr/bin/llmman --version; \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/log/dnf*; \
    getent group openclaw >/dev/null || groupadd -g "${OPENCLAW_GID}" openclaw; \
    id -u openclaw >/dev/null 2>&1 || \
      useradd -u "${OPENCLAW_UID}" -g "${OPENCLAW_GID}" -m -d /var/home/openclaw -s /bin/bash openclaw; \
    usermod -aG wheel openclaw; \
    grep -q '^openclaw:' /etc/subuid 2>/dev/null || \
      printf 'openclaw:%s:%s\n' "${OPENCLAW_SUBID_START}" "${OPENCLAW_SUBID_COUNT}" >> /etc/subuid; \
    grep -q '^openclaw:' /etc/subgid 2>/dev/null || \
      printf 'openclaw:%s:%s\n' "${OPENCLAW_SUBID_START}" "${OPENCLAW_SUBID_COUNT}" >> /etc/subgid; \
    install -d -m 0700 -o openclaw -g openclaw /var/home/openclaw/.openclaw; \
    install -d -m 0755 /var/lib/systemd/linger; \
    touch /var/lib/systemd/linger/openclaw

COPY rootfs/ /

# bootc-fetch-apply-updates.timer is enabled by default on the Fedora
# bootc base and polls whatever registry origin is baked into the image.
# tank-os only supports updates via manual `bootc switch`/`bootc upgrade`
# (see docs/build.md), so the timer just fails on every boot -- most
# visibly on images built locally with the default `localhost/tank-os`
# tag, where there's no registry to poll at all.
RUN set -eux; \
    chmod 0755 \
      /usr/local/bin/openclaw \
      /usr/local/bin/tank-os-version \
      /usr/local/bin/tank-openclaw-secrets \
      /usr/libexec/tank-os/bootstrap-csb-sandbox \
      /usr/libexec/tank-os/bootstrap-service-gator \
      /usr/libexec/tank-os/check-csb-sandbox-health \
      /usr/libexec/tank-os/sync-podman-secrets; \
    chmod 0440 /etc/sudoers.d/openclaw; \
    chown -R openclaw:openclaw /var/home/openclaw; \
    sed -i "s|__CSB_IMAGE_TAG_DEFAULT__|${CSB_IMAGE_TAG}|" \
      /usr/libexec/tank-os/bootstrap-csb-sandbox; \
    sed -i "s|__OPENCLAW_DEFAULT_MODEL_DEFAULT__|${OPENCLAW_DEFAULT_MODEL}|" \
      /usr/libexec/tank-os/bootstrap-csb-sandbox; \
    systemctl enable sshd.service; \
    systemctl mask bootc-fetch-apply-updates.timer; \
    mkdir -p /etc/systemd/user/default.target.wants; \
    ln -sf /usr/lib/systemd/user/openshell-gateway.service \
      /etc/systemd/user/default.target.wants/openshell-gateway.service; \
    ln -sf /usr/lib/systemd/user/openclaw.service \
      /etc/systemd/user/default.target.wants/openclaw.service; \
    ln -sf /usr/lib/systemd/user/llmman.service \
      /etc/systemd/user/default.target.wants/llmman.service; \
    mkdir -p /etc/systemd/user/timers.target.wants; \
    ln -sf /usr/lib/systemd/user/openclaw-healthcheck.timer \
      /etc/systemd/user/timers.target.wants/openclaw-healthcheck.timer; \
    for unit in \
      cloud-init-local.service \
      cloud-init-network.service \
      cloud-init.service \
      cloud-config.service \
      cloud-final.service \
      cloud-init.target; \
    do \
      if [ -e "/usr/lib/systemd/system/${unit}" ] || [ -e "/etc/systemd/system/${unit}" ]; then \
        systemctl enable "${unit}"; \
      fi; \
    done
