#!/usr/bin/env bash
set -euo pipefail

# Runs as an ExecStartPre for openclaw.container, before the OpenClaw
# gateway container itself starts. Three jobs, all idempotent:
#
# 1. Install the openshell plugin into the persisted ~/.openclaw volume.
#    openclaw.json (written by bootstrap-openclaw) already enables
#    plugins.entries.openshell and agents.defaults.sandbox.backend, so the
#    plugin must exist in the volume *before* the gateway's first start --
#    otherwise it starts referencing a plugin that isn't there yet. The
#    plugin can't be installed via `openclaw plugins install` through the
#    normal container (that requires the container to already be running,
#    see /usr/local/bin/openclaw), so this uses a one-shot throwaway
#    container against the same image instead.
# 2. Register the local openshell-gateway with the host's `openshell` CLI.
#    NVIDIA's own install.sh does this automatically
#    (`openshell gateway add https://127.0.0.1:17670 --local --name
#    openshell`) as part of its post-install flow, but tank-os installs the
#    RPM directly via dnf (see bootc/Containerfile) rather than running
#    install.sh, so this step has to be replicated here explicitly --
#    without it, `openshell sandbox get/create` below fails with
#    "No active gateway."
# 3. Pre-create the OpenShell sandbox under a fixed name, using the
#    OpenShell gateway that already runs on this host (see
#    openshell-gateway.service). OpenClaw's plugin then finds it via
#    `sandbox get <name>` and never needs to invoke `sandbox create`
#    itself, which sidesteps plugins.entries.openshell.config.from only
#    documented to accept a bare short name, not a full image reference.

# The literal default below is rewritten at image build time (see
# bootc/Containerfile's sed step) to match the OPENCLAW_OPENSHELL_IMAGE
# build arg -- kept in sync with openclaw.container's Image= line, since
# ExecStartPre scripts don't inherit container build args at runtime.
openclaw_image="${OPENCLAW_OPENSHELL_IMAGE:-__OPENCLAW_OPENSHELL_IMAGE_DEFAULT__}"
openclaw_home="${HOME:-/var/home/openclaw}/.openclaw"
gateway_name="openshell"
gateway_endpoint="https://127.0.0.1:17670"
sandbox_name="tankos-openclaw"
# Pinned by digest, not a mutable tag, for build reproducibility. This
# digest corresponds to tag `55cd0dd44719e6806c5725335b8914012be6461a` in
# that repo (confirmed via `skopeo inspect --raw
# docker://ghcr.io/lobstertrap/openshell-hummingbird-images/sandboxes/openclaw:<tag>
# | sha256sum`, since the tag itself isn't in the pulled image's own
# labels). To update: pick the new tag, run the same `skopeo inspect --raw`
# command against it to get its manifest-list digest, and replace both the
# digest below and this comment's tag reference together -- don't update
# one without the other, or a future reader has no way to tell what this
# digest actually points to.
sandbox_source="ghcr.io/lobstertrap/openshell-hummingbird-images/sandboxes/openclaw@sha256:b1158a087b500548e1650cca1bb8536f6ac3b0bf7c387a6028f920a206423b6a"

if ! find "$openclaw_home/npm/projects" -maxdepth 1 -iname '*openshell*' 2>/dev/null | grep -q .; then
  # :z (shared), not :Z (private) like openclaw.container's own mount of
  # this same path -- this one-shot container previously used :Z too,
  # which intermittently produced EACCES/spawn-EACCES errors in the main
  # OpenClaw container (relabeling the tree exclusive to this short-lived
  # container's SELinux context). :z only relabels this path once, the
  # first time the plugin is installed -- this whole block is skipped on
  # every later boot once `find` above succeeds, so there's no repeated
  # relabel/boot-time cost, just a one-time tag as shared instead of
  # exclusive.
  podman run --rm \
    --userns=keep-id \
    -v "$openclaw_home:/home/node/.openclaw:z" \
    -e HOME=/home/node \
    "$openclaw_image" \
    openclaw plugins install @openclaw/openshell-sandbox
fi

gateway_ready=false
for _ in $(seq 1 30); do
  if systemctl --user is-active --quiet openshell-gateway.service; then
    gateway_ready=true
    break
  fi
  sleep 1
done

if [ "$gateway_ready" != true ]; then
  echo "bootstrap-openshell-sandbox: openshell-gateway.service did not become active within 30s" >&2
  exit 1
fi

if ! openshell gateway select "$gateway_name" >/dev/null 2>&1; then
  openshell gateway add "$gateway_endpoint" --local --name "$gateway_name"
fi

if ! openshell sandbox get "$sandbox_name" >/dev/null 2>&1; then
  # `sandbox create`'s own foreground progress display has been observed to
  # hang even after the sandbox is actually provisioned and healthy (alpha
  # software -- see NVIDIA/OpenShell's own "early-stage" disclaimer). Cap it
  # with `timeout` and treat `sandbox get` afterward as the source of
  # truth, not `create`'s own exit status.
  timeout 600 openshell sandbox create \
    --name "$sandbox_name" \
    --from "$sandbox_source" || true

  if ! openshell sandbox get "$sandbox_name" >/dev/null 2>&1; then
    echo "bootstrap-openshell-sandbox: sandbox create failed or timed out and no sandbox exists" >&2
    exit 1
  fi
fi
