#!/usr/bin/env bash
set -euo pipefail

openclaw_home="${HOME:-/var/home/openclaw}/.openclaw"
config_file="$openclaw_home/openclaw.json"
env_file="$openclaw_home/openclaw.env"

umask 077
mkdir -p \
  "$openclaw_home" \
  "$openclaw_home/workspace" \
  "$openclaw_home/skills" \
  "$openclaw_home/cron"

if [[ ! -f "$config_file" ]]; then
  # `--bind lan` (below) refuses to start without a gateway auth token; a
  # fresh VM has none, so generate one here the same way SSH host keys are
  # generated on first boot instead of leaving the service crash-looping.
  gateway_token="$(head -c32 /dev/urandom | od -An -tx1 | tr -d ' \n')"

  cat >"$config_file" <<JSON
{
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "$gateway_token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        },
        "responses": {
          "enabled": true
        }
      }
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    }
  },
  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "all",
        "backend": "openshell",
        "scope": "session",
        "workspaceAccess": "rw"
      }
    }
  },
  "plugins": {
    "entries": {
      "openshell": {
        "enabled": true,
        "config": {
          "from": "tankos-openclaw",
          "mode": "remote"
        }
      }
    }
  }
}
JSON
  chmod 0600 "$config_file"
else
  # A config from before this OpenShell integration existed (or from a VM
  # upgraded via `bootc upgrade` across that boundary) won't have the
  # sandbox/plugin entries below -- backfill them in place with python3
  # (already a dependency, see bootc/Containerfile) rather than blind text
  # substitution, and only fill in what's missing so any customization the
  # user already made to their config survives.
  python3 - "$config_file" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path) as f:
    config = json.load(f)

defaults = config.setdefault("agents", {}).setdefault("defaults", {})
if "sandbox" not in defaults:
    defaults["sandbox"] = {
        "mode": "all",
        "backend": "openshell",
        "scope": "session",
        "workspaceAccess": "rw",
    }

entries = config.setdefault("plugins", {}).setdefault("entries", {})
if "openshell" not in entries:
    entries["openshell"] = {
        "enabled": True,
        "config": {
            "from": "tankos-openclaw",
            "mode": "remote",
        },
    }

with open(path, "w") as f:
    json.dump(config, f, indent=2)
    f.write("\n")
PY
  chmod 0600 "$config_file"
fi

if [[ ! -f "$env_file" ]]; then
  # Reuse the token already stored in openclaw.json (whether just written
  # above or pre-existing from before openclaw.env existed) -- generating a
  # fresh one here would desync it from what's already in the config's
  # gateway.auth.token, breaking gateway auth.
  gateway_token="$(python3 -c \
    'import json,sys; print(json.load(open(sys.argv[1]))["gateway"]["auth"]["token"])' \
    "$config_file")"

  cat >"$env_file" <<ENV
OPENCLAW_GATEWAY_TOKEN=$gateway_token
ENV
  chmod 0600 "$env_file"
fi
